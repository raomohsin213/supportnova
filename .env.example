# =====================================================================
# SupportNova Environment Configuration
# Copy this file to .env in the project root:
#   Windows: copy .env.example .env
#   Mac/Linux: cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# GenAI API Keys (Optional -- app includes deterministic offline fallback)
# ---------------------------------------------------------------------
# Obtain a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Secondary Cascade Engines (Optional)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3.5-lightning:free

# ---------------------------------------------------------------------
# Security & Authentication
# ---------------------------------------------------------------------
JWT_SECRET_KEY=supportnova_techwiz7_secret_super_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------
# Database Configuration
# Primary local storage is SQLite (support_nova.db, created automatically).
# MongoDB Atlas is an optional cloud sync layer.
# ---------------------------------------------------------------------
MONGODB_DB_NAME=support_nova
DATABASE_BACKEND=mongodb
# Uncomment and supply your own MongoDB URI if you wish to use a custom cluster:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
